# Виртуальное окружение — у каждого своё, не коммитим
.venv/
venv/

# Кэш Python — генерируется автоматически
__pycache__/
*.py[cod]

# Кэш pytest
.pytest_cache/

# Отчёты Allure — это артефакты, они генерируются
allure-results/
allure-report/

# Секреты и переменные окружения — НИКОГДА не коммитим
.env
.env.local

# IDE-файлы
.idea/
.vscode/
